#!/usr/bin/env bash
#
# server - Start development servers
#
# Usage:
#   ./scripts/server [port]             # Start frontend server (default port 8080)
#   ./scripts/server 9000               # Start frontend on port 9000
#   ./scripts/server 8137 --exact       # Bind EXACTLY 8137; fail if occupied
#   ./scripts/server enrichment         # Start enrichment preview viewer
#   ./scripts/server --cleanup          # Kill all dev servers
#
# If the port is in use, automatically tries the next available port.
# With --exact (or BGB_EXACT_PORT=1) the server instead exits non-zero if
# the requested port is occupied. Used by Playwright (playwright.config.js)
# so tests never silently attach to a foreign server.
#
# For source-specific servers (like debug viewers), use:
#   ./sources/classic-country/scripts/server debug_viewer
#

set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# Kill existing bluegrassbook servers (Python http.server on ports 8080-8090).
# Only used by --cleanup so multiple instances can coexist on different ports.
kill_existing_servers() {
    local killed=false
    # Check ports 8080-8090 for Python servers
    for port in $(seq 8080 8090); do
        # NB: lsof can return SEVERAL pids (parent + workers, or two
        # servers on one port). The old `kill "$pid"` passed them as a
        # single newline-joined argument and failed SILENTLY — a zombie
        # server from another worktree kept the port while the new one
        # quietly relocated (+1) and the browser kept talking to the
        # zombie (this served week-old feature-visual-editor data on
        # 8081 for days). Kill each pid separately.
        for pid in $(lsof -t -i:"$port" 2>/dev/null); do
            local cmd=$(ps -p "$pid" -o comm= 2>/dev/null)
            if [[ "$cmd" == *"ython"* ]]; then
                if [ "$killed" = false ]; then
                    echo "Killing existing bluegrassbook servers..."
                    killed=true
                fi
                kill "$pid" 2>/dev/null || true
            fi
        done
    done
    if [ "$killed" = true ]; then
        sleep 0.5
    fi
}

# Check if a port is available
port_available() {
    ! lsof -i:"$1" >/dev/null 2>&1
}

# Find an available port starting from the given port
find_available_port() {
    local port="$1"
    local max_attempts=20
    local attempt=0

    while [ $attempt -lt $max_attempts ]; do
        if port_available "$port"; then
            echo "$port"
            return 0
        fi
        echo "Port $port is in use, trying $((port + 1))..." >&2
        port=$((port + 1))
        attempt=$((attempt + 1))
    done

    echo "Could not find available port after $max_attempts attempts" >&2
    return 1
}

# Strict port mode: --exact flag or BGB_EXACT_PORT=1 disables auto-increment.
EXACT_PORT="${BGB_EXACT_PORT:-}"
ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--exact" ]; then
        EXACT_PORT=1
    else
        ARGS+=("$arg")
    fi
done

# Parse arguments - check if first arg is a number (port) or command
ARG1="${ARGS[0]:-frontend}"
ARG2="${ARGS[1]:-}"

EXPLICIT_PORT=false
if [[ "$ARG1" =~ ^[0-9]+$ ]]; then
    # First arg is a port number
    COMMAND="frontend"
    PORT="$ARG1"
    EXPLICIT_PORT=true
elif [[ -n "$ARG2" && "$ARG2" =~ ^[0-9]+$ ]]; then
    # Second arg is a port number
    COMMAND="$ARG1"
    PORT="$ARG2"
    EXPLICIT_PORT=true
else
    COMMAND="$ARG1"
    PORT="8080"
fi

case "$COMMAND" in
    frontend|"")
        # Multiple instances (e.g. different worktrees) may run at once on
        # different ports, so starting a server never kills the others —
        # use ./scripts/server --cleanup for that.
        if [ -n "$EXACT_PORT" ]; then
            if ! port_available "$PORT"; then
                echo "Error: port $PORT is already in use (strict --exact mode; not auto-incrementing)." >&2
                echo "Free port $PORT or choose another (e.g. PW_PORT=<port> for Playwright)." >&2
                exit 1
            fi
        elif [ "$EXPLICIT_PORT" = true ] && ! port_available "$PORT"; then
            # An EXPLICITLY requested port must not silently relocate:
            # the browser stays on the requested port, talking to
            # whatever process still holds it, and you debug stale data
            # for an afternoon. Fail loudly instead.
            echo "ERROR: port $PORT is still in use by:" >&2
            lsof -i:"$PORT" | sed 's/^/  /' >&2
            echo "Kill it (kill \$(lsof -t -i:$PORT)) or pick another port." >&2
            exit 1
        else
            PORT=$(find_available_port "$PORT")
        fi
        echo "Starting frontend server..."
        echo "Serving: $REPO_ROOT/docs"
        echo "Visit: http://localhost:$PORT"
        # The server binds all interfaces, so if Tailscale is up the same
        # port is reachable from any device on the tailnet (phone testing).
        if command -v tailscale >/dev/null 2>&1; then
            TS_NAME=$(tailscale status --json 2>/dev/null \
                | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['Self']['DNSName'].rstrip('.')) if d['Self'].get('Online') else None" 2>/dev/null)
            if [ -n "$TS_NAME" ] && [ "$TS_NAME" != "None" ]; then
                echo "Tailnet: http://$TS_NAME:$PORT  (phone: open this on any tailnet device)"
            fi
        fi
        python3 -c "
import gzip, http.server, io, os

# Text assets worth compressing. index.jsonl/archive.jsonl/*.pro dominate the
# payload (the split index is fetched at startup, .pro files per song open),
# so serving them gzipped locally mirrors what GitHub Pages does in
# production — otherwise phone/tailnet testing measures the wrong numbers.
GZIP_EXTS = ('.jsonl', '.json', '.pro', '.js', '.css', '.html')
GZIP_MIN_BYTES = 512

class NoCacheHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory='docs', **kwargs)

    def end_headers(self):
        self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
        super().end_headers()

    def _client_accepts_gzip(self):
        return 'gzip' in (self.headers.get('Accept-Encoding') or '').lower()

    def send_head(self):
        # Compress in memory and hand a BytesIO back to copyfile(), so the
        # rest of SimpleHTTPRequestHandler (ranges aside) is untouched.
        path = self.translate_path(self.path)
        if (self.command in ('GET', 'HEAD')
                and self._client_accepts_gzip()
                and not os.path.isdir(path)
                and path.lower().endswith(GZIP_EXTS)
                and os.path.isfile(path)
                and os.path.getsize(path) >= GZIP_MIN_BYTES):
            try:
                with open(path, 'rb') as f:
                    raw = f.read()
            except OSError:
                return super().send_head()
            body = gzip.compress(raw, 6)
            st = os.stat(path)
            self.send_response(200)
            self.send_header('Content-Type', self.guess_type(path))
            self.send_header('Content-Encoding', 'gzip')
            self.send_header('Content-Length', str(len(body)))
            self.send_header('Vary', 'Accept-Encoding')
            self.send_header('Last-Modified', self.date_time_string(int(st.st_mtime)))
            self.end_headers()
            return io.BytesIO(body)
        return super().send_head()

http.server.ThreadingHTTPServer(('', $PORT), NoCacheHandler).serve_forever()
"
        ;;
    enrichment|enrichment-viewer|enrich)
        echo "Starting enrichment preview viewer..."
        uv run python3 scripts/enrichment-viewer/server.py
        ;;
    --cleanup|cleanup)
        kill_existing_servers
        echo "All dev servers stopped."
        ;;
    help|--help|-h)
        echo "Usage: ./scripts/server [port] [command]"
        echo ""
        echo "Commands:"
        echo "  frontend     Start the main frontend (default)"
        echo "  enrichment   Start the enrichment preview viewer"
        echo "  --cleanup    Kill all dev servers (ports 8080-8090)"
        echo ""
        echo "Options:"
        echo "  port         Port number (default: 8080; the default auto-increments"
        echo "               if busy, an explicitly requested port fails loudly instead)"
        echo "  --exact      Bind exactly the requested port; exit 1 if occupied"
        echo "               (also via BGB_EXACT_PORT=1; used by Playwright e2e)"
        echo ""
        echo "Examples:"
        echo "  ./scripts/server           # Frontend on port 8080"
        echo "  ./scripts/server 9000      # Frontend on port 9000"
        echo "  ./scripts/server --cleanup # Stop all dev servers"
        echo ""
        ;;
    *)
        echo "Unknown command: $COMMAND"
        echo "Run './scripts/server help' for usage"
        exit 1
        ;;
esac
